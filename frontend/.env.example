# .env.example (frontend)
# -----------------------------------------------------------------------------
# ตัวแปรแวดล้อมของฝั่งหน้าบ้าน (Vite)
#
# ตอนพัฒนาบนเครื่อง: ไม่ต้องมีไฟล์ .env เลย
#   ปล่อยว่างไว้ -> เว็บเรียก /api ผ่าน vite proxy ไปหา backend ที่ localhost:5000
#
# ตอน deploy บน Vercel: ไปพิมพ์ค่านี้ในหน้า
#   Vercel > Settings > Environment Variables
# -----------------------------------------------------------------------------

# ที่อยู่ของ backend บน Render (ได้มาหลัง deploy backend เสร็จ)
# ห้ามมี / ปิดท้าย
# ตัวอย่าง:
#   VITE_API_URL=https://tidsure-api.onrender.com
VITE_API_URL=
