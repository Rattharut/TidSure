# .env.example (backend)
# -----------------------------------------------------------------------------
# ไฟล์ตัวอย่างของตัวแปรแวดล้อม (environment variables)
#
# ตอนพัฒนาบนเครื่อง: ก็อปไฟล์นี้เป็น ".env" แล้วเติมค่าจริง (.env ไม่ถูก push ขึ้น git)
#   คำสั่ง (PowerShell):  Copy-Item .env.example .env
#
# ตอน deploy บน Render: ไม่ต้องมีไฟล์ .env — ให้ไปพิมพ์ค่าพวกนี้ในหน้า
#   Render > Environment > Environment Variables แทน
# -----------------------------------------------------------------------------

# พอร์ตที่เซิร์ฟเวอร์จะรัน (Render กำหนด PORT ให้เองอัตโนมัติ ตอน deploy ไม่ต้องตั้ง)
PORT=5000

# สตริงเชื่อมต่อ MongoDB Atlas
# เอามาจาก: MongoDB Atlas > Cluster > Connect > Drivers
# แทน <username>, <password>, <dbname> เป็นค่าจริง
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ที่อยู่ของ frontend ที่อนุญาตให้เรียก API (CORS)
# ตั้งได้หลายอันคั่นด้วยจุลภาค (ไม่มีเว้นวรรค) เผื่อทดสอบจากเครื่อง + เว็บจริงพร้อมกัน
# ตัวอย่างตอน deploy จริง:
#   CLIENT_ORIGIN=http://localhost:5173,https://tidsure.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# กุญแจลับสำหรับเซ็น JWT (ระบบล็อกอิน) — ต้องมี ไม่งั้นเซิร์ฟเวอร์ไม่ยอมเริ่ม
# สร้างข้อความสุ่มยาว ๆ ด้วยคำสั่ง:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=<ใส่ข้อความสุ่มยาว ๆ ตรงนี้>

# อายุของ token ก่อนหมดอายุ (7d = 7 วัน)
JWT_EXPIRES_IN=7d
